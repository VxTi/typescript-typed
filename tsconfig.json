{
  "extends": "./tsconfig.strict.json",
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "NodeNext",
    "lib": ["ESNext"],
    "rootDir": "./src",
    "outDir": "./dist",

    "skipLibCheck": true,

    "moduleResolution": "NodeNext",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noUncheckedIndexedAccess": true,
    "emitDeclarationOnly": false,
    "noEmit": false,
    "declaration": true
  },
  "include": ["./src/**/*.ts"],
  "exclude": [
    "dist",
    "./**/__testutils__",
    "./**/*.test.ts",
    "./node_modules"
  ]
}
